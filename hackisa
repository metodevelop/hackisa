def checkbox_select(items, defaults=None):
    """Interactive checkbox selection with arrow keys."""
    if not sys.stdin.isatty():
        return defaults or [True] * len(items)

    selected = list(defaults) if defaults else [True] * len(items)
    cursor = 0

    def render():
        sys.stdout.write(f"\033[{len(items) + 1}A")
        print(f"  {DIM}↑↓ навигация  Пробел — переключить  Enter — готово{RST}")
        for i, (label, _) in enumerate(items):
            check = f"{GREEN}✓{RST}" if selected[i] else f"{GRAY}·{RST}"
            pointer = f"{WHITE}{BOLD}›{RST}" if i == cursor else " "
            highlight = WHITE + BOLD if i == cursor else ""
            print(f"  {pointer} [{check}] {highlight}{label}{RST}")

    print(f"  {DIM}↑↓ навигация  Пробел — переключить  Enter — готово{RST}")
    for i, (label, _) in enumerate(items):
        check = f"{GREEN}✓{RST}" if selected[i] else f"{GRAY}·{RST}"
        pointer = f"{WHITE}{BOLD}›{RST}" if i == cursor else " "
        print(f"  {pointer} [{check}] {label}{RST}")

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        while True:
            ch = sys.stdin.read(1)
            if ch == "\r" or ch == "\n":
                break
            if ch == " ":
                selected[cursor] = not selected[cursor]
                render()
            elif ch == "\x1b":
                ch2 = sys.stdin.read(1)
                if ch2 == "[":
                    ch3 = sys.stdin.read(1)
                    if ch3 == "A" and cursor > 0:
                        cursor -= 1
                        render()
                    elif ch3 == "B" and cursor < len(items) - 1:
                        cursor += 1
                        render()
            elif ch == "\x03":
                raise KeyboardInterrupt
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

    print()
    return selected


