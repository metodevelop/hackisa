def check_firmware_risk(version_str):
    """Check if firmware version might be patched against root exploit."""
    for prefix in KNOWN_PATCHED:
        if version_str.startswith(prefix):
            return True
    return False


def backup_station(ip, station_name):
    """Backup critical partitions before modifying."""
    ts = time.strftime("%Y%m%d_%H%M%S")
    backup_dir = os.path.join(BASE, "backups", f"{station_name}_{ts}")
    os.makedirs(backup_dir, exist_ok=True)

    targets = [
        "/system/vendor/quasar/",
        "/persist/",
    ]
    for t in targets:
        dest_name = t.strip("/").replace("/", "_")
        info(f"бэкап {t} ...")
        r = run(f"adb -s {ip}:5555 pull {t} {os.path.join(backup_dir, dest_name)}", timeout=60)
        if r.returncode == 0:
            ok(f"  → {dest_name}")
        else:
            warn(f"  не удалось: {t}")

    ok(f"бэкап сохранён в {os.path.relpath(backup_dir, BASE)}/")
    return backup_dir


class SessionLogger:
    """Tee stdout to a log file."""
    def __init__(self, path):
        self.terminal = sys.stdout
        os.makedirs(os.path.dirname(path), exist_ok=True)
        self.log = open(path, "w")
        self.ansi_re = re.compile(r'\033\[[0-9;]*m')

    def write(self, msg):
        self.terminal.write(msg)
        self.log.write(self.ansi_re.sub("", msg))
        self.log.flush()

    def flush(self):
        self.terminal.flush()
        self.log.flush()

    def isatty(self):
        return self.terminal.isatty()

    def fileno(self):
        return self.terminal.fileno()

    def close(self):
        sys.stdout = self.terminal
        self.log.close()


def healthcheck(ip, station):
    """Verify root state after setup."""
    print()
    info("проверяю состояние станции...")
    print()
    all_ok = True

    # ADB
    r = run(f"adb -s {ip}:5555 shell id")
    if "root" in r.stdout:
        ok("ADB root ✓")
    else:
        err("ADB не root")
        all_ok = False

    # ADB marker
    r = run(f"adb -s {ip}:5555 shell ls /persist/adbd")
    if r.returncode == 0:
        ok("ADB маркер ✓")
    else:
        warn("ADB маркер не найден")

    # dropbear
    r = run(f"adb -s {ip}:5555 shell pidof dropbear")
    if r.stdout.strip():
        ok("Dropbear SSH работает ✓")
    else:
        warn("Dropbear не запущен")

    # updates blocked
    r = run(f"adb -s {ip}:5555 shell ls /usr/bin/updatesd 2>/dev/null")
    if r.returncode != 0:
        ok("обновления заблокированы ✓")
    else:
        warn("updatesd всё ещё на месте")

    # LED panel (if applicable)
    if station.get("led"):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(2)
            s.connect((ip, 8080))
            s.close()
            ok("LED-панель доступна ✓")
        except:
            warn("LED-панель не отвечает на :8080")

    print()
    if all_ok:
        ok("всё в порядке!")
    else:
        warn("есть проблемы — проверь логи")
    return all_ok


