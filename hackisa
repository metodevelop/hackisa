def _get_arp_lines():
    if IS_LINUX:
        r = run("ip neigh show")
    else:
        r = run("arp -an")
    return r.stdout.splitlines() if r.returncode == 0 else []

def _get_gateway():
    if IS_LINUX:
        r = run("ip route show default")
        if r.returncode == 0:
            m = re.search(r'default via (\d+\.\d+\.\d+\.\d+)', r.stdout)
            if m:
                return m.group(1)
    else:
        r = run("route -n get default 2>/dev/null | grep gateway")
        if r.returncode == 0:
            m = re.search(r'(\d+\.\d+\.\d+\.\d+)', r.stdout)
            if m:
                return m.group(1)
    return ""

