def root_station():
    """Full root pipeline."""
    global _stand_running
    clear()
    print(BANNER)
    print(TITLE)
    print(f"  {WHITE}{BOLD}Рутование станции{RST}\n")

    ip = get_local_ip()
    info(f"твой IP: {WHITE}{ip}{RST}")

    station = choose_station()

    TOTAL = 7

    # ── 1. Check environment ──
    step(1, TOTAL, "проверка окружения")

    checks = {
        "python3": has("python3"),
        "adb":     has("adb"),
        "dnsmasq": has("dnsmasq") or (IS_MAC and os.path.exists("/opt/homebrew/sbin/dnsmasq")),
        "dig":     has("dig"),
    }
    all_ok = True
    for name, found in checks.items():
        if found:
            ok(f"{name}")
        else:
            err(f"{name} не найден")
            all_ok = False

    fw_dir = os.path.join(BASE, "firmware")
    platform = station["platform"]
    platform_fw_dir = os.path.join(fw_dir, platform)
    fw_file = None

    if os.path.isdir(platform_fw_dir):
        for f in os.listdir(platform_fw_dir):
            if f.endswith(".zip"):
                fw_file = os.path.join(platform_fw_dir, f)
                break

    if fw_file:
        ok(f"прошивка для {WHITE}{platform}{RST}: {os.path.basename(fw_file)}")
        manifest_path = os.path.join(platform_fw_dir, "manifest.json")
        if os.path.exists(manifest_path):
            import json as _json
            try:
                mf = _json.load(open(manifest_path))
                if mf.get("platform") != platform:
                    warn(f"manifest.json указывает на {mf.get('platform')}, а не {platform}!")
                else:
                    info(f"версия: {WHITE}{mf.get('version', '?')}{RST}  размер: {WHITE}{mf.get('size', 0) // 1048576} МБ{RST}")
            except:
                pass
    else:
        # check if there's firmware for another platform
        other_fw = []
        if os.path.isdir(fw_dir):
            for d in os.listdir(fw_dir):
                sub = os.path.join(fw_dir, d)
                if os.path.isdir(sub) and d != platform:
                    for f in os.listdir(sub):
                        if f.endswith(".zip"):
                            other_fw.append(d)
                            break
        if other_fw:
            warn(f"прошивка для {WHITE}{platform}{RST} не найдена!")
            warn(f"есть прошивки для: {WHITE}{', '.join(other_fw)}{RST} — они НЕ подходят для {station['name']}")
        else:
            warn("прошивка не найдена в firmware/")
        info(f"скачай прошивку для {WHITE}{platform}{RST} и положи в:")
        info(f"  {WHITE}firmware/{platform}/<версия>.zip{RST}")
        info(f"прошивки можно найти на {CYAN}hackalice.me{RST} или в Telegram-чатах")

    if not checks["dnsmasq"]:
        if IS_LINUX:
            warn("dnsmasq не найден — sudo apt install dnsmasq (нужен для стенда)")
        else:
            warn("dnsmasq не найден — brew install dnsmasq (нужен для стенда)")
    if not checks["adb"]:
        if IS_LINUX:
            err("установи adb: sudo apt install adb")
        else:
            err("установи adb: brew install android-platform-tools")
        sys.exit(1)

    # ── 2. Start stand ──
    step(2, TOTAL, "запуск стенда (DNS + eQuasar)")

    info("поднимаю DNS-перехват и HTTPS-сервер..")
    print(f"    {DIM}quasar.yandex.net → {ip}{RST}")
    print(f"    {DIM}quasar.yandex.ru  → {ip}{RST}")
    print(f"    {DIM}scbh.yandex.net   → {ip}{RST}")
    print()

    if not ask("запустить стенд? (нужен sudo)"):
        warn("пропускаю запуск стенда")
    else:
        log_path = os.path.join(BASE, "log", "server.log")
        os.makedirs(os.path.join(BASE, "log"), exist_ok=True)
        try:
            with open(log_path, "w") as f:
                pass
        except PermissionError:
            run(f"sudo chmod 666 {log_path}")
            with open(log_path, "w") as f:
                pass

        r = run_show(f"sudo {BASE}/start.sh", timeout=30)
        if r.returncode == 0:
            _stand_running = True
            ok("стенд запущен")
        else:
            err("ошибка при запуске стенда")
            if not ask("продолжить всё равно?", "n"):
                sys.exit(1)

    # ── 3. Find station ──
    step(3, TOTAL, "поиск станции в сети")

    subnet = ".".join(ip.split(".")[:3]) if ip else None
    if not subnet:
        err("не могу определить подсеть")
        sys.exit(1)

    station_ip = None
    stations = find_station(subnet)

    if stations:
        show_network_map(ip, stations, subnet)
        for sip in stations:
            ok(f"нашёл: {WHITE}{sip}{RST}")
        station_ip = stations[0]
    else:
        warn("станция не найдена по MAC")
        manual = input(f"  {GRAY}[?]{RST} введи IP станции (или Enter для повторного скана): ").strip()
        if manual:
            station_ip = manual
        else:
            warn("жду подключения станции к сети...")
            for attempt in range(10):
                time.sleep(10)
                stations = find_station(subnet)
                if stations:
                    station_ip = stations[0]
                    ok(f"нашёл: {WHITE}{station_ip}{RST}")
                    break
                sys.stdout.write(f"\r  {GRAY}[·]{RST} попытка {attempt+2}/10...")
                sys.stdout.flush()
            print()

    if not station_ip:
        err("станция не найдена")
        stop_stand()
        sys.exit(1)

    # ── 4. Wait for ADB ──
    step(4, TOTAL, "ожидание ADB")

    info("станция должна получить sync с adbd=true и открыть :5555")
    info("это может занять 1-5 минут...")

    # tail server log in background
    log_path = os.path.join(BASE, "log", "server.log")
    stop_log = threading.Event()
    if os.path.exists(log_path):
        log_thread = threading.Thread(target=tail_log, args=(log_path, stop_log), daemon=True)
        log_thread.start()

    if wait_adb(station_ip, timeout=300):
        print()
        ok(f"ADB открыт на {station_ip}:5555")
        stop_log.set()
    else:
        stop_log.set()
        err("таймаут ожидания ADB (5 минут)")
        if not ask("продолжить? может, порт уже открыт", "n"):
            stop_stand()
            sys.exit(1)

    # ── 5. Connect & root ──
    step(5, TOTAL, "подключение и настройка")

    if adb_connect(station_ip):
        ok("ADB подключён, root доступ ✓")
    else:
        err("не удалось подключиться по ADB")
        stop_stand()
        sys.exit(1)

    # firmware version
    r = run(f"adb -s {station_ip}:5555 shell cat /system/vendor/quasar/version_full")
    fw_version = r.stdout.strip()
    if fw_version:
        info(f"прошивка: {WHITE}{fw_version}{RST}")
        if check_firmware_risk(fw_version):
            warn(f"прошивка {fw_version} может быть пропатчена!")
            warn("рут может не сработать на свежих версиях")
            if not ask("продолжить всё равно?", "n"):
                stop_stand()
                sys.exit(1)

    # backup before changes
    if ask("сделать бэкап перед изменениями?"):
        backup_station(station_ip, station["id"])

    # persistent ADB marker
    info("фиксирую ADB маркер (chattr +i)...")
    run(f"adb -s {station_ip}:5555 shell 'touch /persist/adbd && chattr +i /persist/adbd'")
    ok("ADB маркер установлен")

    # ── 6. Post-root ──
    step(6, TOTAL, "пост-рут установка")

    print()
    actions = [
        ("dropbear (SSH на :2222)", "dropbear"),
        ("блокировка обновлений",  "noupdate"),
        ("yse/Entware",            "yse"),
    ]
    if station.get("led"):
        actions.append(("LED-панель",  "ledpanel"))

    info("выбери что установить:")
    print()
    chosen = checkbox_select(actions, defaults=[True, True, True] + ([True] if station.get("led") else []))

    installers = {
        "dropbear": install_dropbear,
        "noupdate": install_noupdate,
        "yse":      install_yse,
        "ledpanel": install_ledpanel,
    }
    for i, (label, key) in enumerate(actions):
        if chosen[i]:
            installers[key](station_ip)

    # ── 7. Healthcheck ──
    step(7, TOTAL, "проверка")
    if ask("запустить проверку?"):
        healthcheck(station_ip, station)

    # ── done ──
    stop_stand()
    print()
    print(f"  {GREEN}{BOLD}{'━' * 40}{RST}")
    print()
    ok(f"{WHITE}{station['name']}{RST} ({station_ip}) рутована!")
    print()
    info(f"ADB:  {WHITE}adb connect {station_ip}:5555{RST}")
    info(f"SSH:  {WHITE}ssh -p 2222 root@{station_ip}{RST}")
    if station.get("led"):
        info(f"LED:  {WHITE}http://{station_ip}:8080{RST}")
    print()
    print(f"  {DIM}metoinc develop × hackisa{RST}")
    print()
    input(f"  {GRAY}[Enter]{RST} назад в меню ")


# ── post-root installers ──

def install_dropbear(ip):
    info("устанавливаю Dropbear SSH...")
    ext_repo = os.path.join(os.path.dirname(BASE), "yandex-station-extended")
    db_bin = os.path.join(ext_repo, "dropbear", "aarch64", "dropbear")
    dbkey_bin = os.path.join(ext_repo, "dropbear", "aarch64", "dropbearkey")

    if not os.path.exists(db_bin):
        warn(f"не найден {db_bin}")
        warn("склонируй yandex-station-extended рядом с lite-kit")
        return

    run(f"adb -s {ip}:5555 shell mkdir -p /data/opt/bin /data/opt/etc/dropbear")
    run(f"adb -s {ip}:5555 push {db_bin} /data/opt/bin/dropbear")
    run(f"adb -s {ip}:5555 push {dbkey_bin} /data/opt/bin/dropbearkey")
    run(f"adb -s {ip}:5555 shell chmod +x /data/opt/bin/dropbear /data/opt/bin/dropbearkey")

    init_script = '''#!/bin/sh
DB=/data/opt/bin/dropbear
DIR=/data/opt/etc/dropbear
HK=$DIR/hk_ed25519
start() {
  [ -x "$DB" ] || return 1
  [ -s "$HK" ] || /data/opt/bin/dropbearkey -t ed25519 -f "$HK" 2>/dev/null || return 1
  pidof dropbear >/dev/null 2>&1 && return 0
  "$DB" -r "$HK" -p 2222 -B
}
case "$1" in
  start)   start ;;
  stop)    killall dropbear 2>/dev/null ;;
  restart) killall dropbear 2>/dev/null; sleep 1; start ;;
esac
exit 0'''

    run(f"adb -s {ip}:5555 shell mount -o remount,rw /")
    run(f"adb -s {ip}:5555 shell 'cat > /etc/init.d/S99zdropbear << \"DEOF\"\n{init_script}\nDEOF'")
    run(f"adb -s {ip}:5555 shell chmod +x /etc/init.d/S99zdropbear")
    run(f"adb -s {ip}:5555 shell /etc/init.d/S99zdropbear start")
    run(f"adb -s {ip}:5555 shell mount -o remount,ro /")

    ok("Dropbear SSH установлен (порт 2222, пароль пустой)")

def install_noupdate(ip):
    info("блокирую обновления...")
    ext_repo = os.path.join(os.path.dirname(BASE), "yandex-station-extended")
    script = os.path.join(ext_repo, "yandex-noupdate.sh")

    if os.path.exists(script):
        run(f"adb -s {ip}:5555 push {script} /data/opt/yandex-noupdate.sh")
        run(f"adb -s {ip}:5555 shell chmod +x /data/opt/yandex-noupdate.sh")
        run(f"adb -s {ip}:5555 shell sh /data/opt/yandex-noupdate.sh")
    else:
        # fallback: manual block
        run(f"adb -s {ip}:5555 shell mount -o remount,rw /")
        run(f"adb -s {ip}:5555 shell 'rm -f /usr/bin/updatesd 2>/dev/null; echo \"#!/bin/sh\" > /usr/bin/ota_updater; chmod +x /usr/bin/ota_updater'")
        run(f"adb -s {ip}:5555 shell mount -o remount,ro /")

    ok("обновления заблокированы")

def install_yse(ip):
    info("устанавливаю yse/Entware...")
    ext_repo = os.path.join(os.path.dirname(BASE), "yandex-station-extended")
    yse_script = os.path.join(ext_repo, "install-yse.sh")

    if os.path.exists(yse_script):
        run(f"adb -s {ip}:5555 push {yse_script} /data/opt/install-yse.sh")
        run(f"adb -s {ip}:5555 shell chmod +x /data/opt/install-yse.sh && sh /data/opt/install-yse.sh", timeout=120)
        ok("yse/Entware установлен")
    else:
        warn("install-yse.sh не найден — установи вручную")

def install_ledpanel(ip):
    info("устанавливаю LED-панель...")
    panel = os.path.join(BASE, "led-panel.py")
    if not os.path.exists(panel):
        warn("led-panel.py не найден")
        return

    # need python3 on station
    r = run(f"adb -s {ip}:5555 shell ls /opt/bin/python3")
    if r.returncode != 0:
        warn("python3 не установлен на станции — сначала установи yse и python3")
        return

    run(f"adb -s {ip}:5555 push {panel} /data/opt/led-panel.py")

    init_script = '''#!/bin/sh
DAEMON=/opt/bin/python3
SCRIPT=/data/opt/led-panel.py
start() {
    [ -x "$DAEMON" ] || return 1
    [ -f "$SCRIPT" ] || return 1
    pidof python3 | grep -q . && return 0
    "$DAEMON" "$SCRIPT" >> /data/opt/led-panel.log 2>&1 &
}
stop() { killall python3 2>/dev/null; }
case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
esac
exit 0'''

    run(f"adb -s {ip}:5555 shell mount -o remount,rw /")
    run(f"adb -s {ip}:5555 shell 'cat > /etc/init.d/S98ledpanel << \"LEOF\"\n{init_script}\nLEOF'")
    run(f"adb -s {ip}:5555 shell chmod +x /etc/init.d/S98ledpanel")
    run(f"adb -s {ip}:5555 shell /etc/init.d/S98ledpanel start")
    run(f"adb -s {ip}:5555 shell mount -o remount,ro /")

    ok(f"LED-панель запущена — http://{ip}:8080")


