def clear():
    if sys.stdout.isatty():
        os.system("clear" if os.name != "nt" else "cls")

def pr(msg, prefix="*", color=CYAN):
    print(f"  {color}{BOLD}[{prefix}]{RST} {msg}")

def ok(msg):
    pr(msg, "✓", GREEN)

def warn(msg):
    pr(msg, "!", YELLOW)

def err(msg):
    pr(msg, "✗", RED)

def info(msg):
    pr(msg, "·", GRAY)

def step(n, total, msg):
    width = 20
    filled = int(width * n / total)
    pct = int(100 * n / total)
    bar = f"{CYAN}{'█' * filled}{GRAY}{'░' * (width - filled)}{RST}"
    print(f"\n  {bar} {WHITE}{BOLD}{pct}%{RST}  {WHITE}[{n}/{total}]{RST} {msg}\n")

def ask(prompt, default="y"):
    hint = "Y/n" if default == "y" else "y/N"
    r = input(f"  {GRAY}[?]{RST} {prompt} [{hint}]: ").strip().lower()
    if not r:
        return default == "y"
    return r in ("y", "yes", "д", "да")

