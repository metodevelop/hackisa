F = "██"  # full
H = "▓▓"  # highlight
D = "░░"  # dim
E = "  "  # empty

def _grid(rows, color=WHITE, pad="  "):
    out = [color]
    for row in rows:
        out.append(pad + "".join(F if c == "1" else E for c in row))
    out.append(RST)
    return "\n".join(out)

