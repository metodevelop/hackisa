        try:
            r = run("ipconfig getifaddr en0")
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
            r = run("ipconfig getifaddr en1")
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
        except:
            pass
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except:
        return None

def find_station(subnet):
    """Scan subnet for Yandex Station (MAC b8:87:6e)."""
    spin = Spinner(f"сканирую {subnet}.0/24...").start()
    ping_timeout = "-W1" if IS_LINUX else "-W150"
    procs = []
    for i in range(2, 255):
        p = subprocess.Popen(
            ["ping", "-c1", ping_timeout, f"{subnet}.{i}"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        procs.append(p)
    for p in procs:
        p.wait()
    time.sleep(0.5)
    spin.stop()
    arp_lines = _get_arp_lines()
    ips = []
    for line in arp_lines:
        if "b8:87:6e" in line.lower():
            m = re.search(r'(\d+\.\d+\.\d+\.\d+)', line)
            if m:
                ips.append(m.group(1))
    return ips

def adb_connect(ip):
    run(f"adb start-server")
    r = run(f"adb connect {ip}:5555")
    time.sleep(1)
    r2 = run(f"adb -s {ip}:5555 shell id")
    return "root" in r2.stdout

def wait_adb(ip, timeout=300):
    """Wait for ADB port to open."""
    tips = [
        "станция должна быть подключена к Wi-Fi стенда",
        "если станция мигает — она ещё грузится, подожди",
        "попробуй перезагрузить станцию если дольше 3 минут",
        "убедись что dnsmasq отдаёт правильный IP",
        "Ctrl+C чтобы отменить и остановить стенд",
    ]
    start = time.time()
    dots = 0
    next_tip = 30
    tip_idx = 0
    while time.time() - start < timeout:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(2)
            s.connect((ip, 5555))
            s.close()
            return True
        except:
            pass
        dots += 1
        elapsed = int(time.time() - start)
        frame = Spinner.FRAMES[dots % len(Spinner.FRAMES)]
        sys.stdout.write(f"\r  {CYAN}{frame}{RST} жду ADB на {ip}:5555 ({elapsed}s) {'.' * (dots % 4)}   ")
        sys.stdout.flush()
        if elapsed >= next_tip and tip_idx < len(tips):
            print(f"\n  {DIM}💡 {tips[tip_idx]}{RST}")
            tip_idx += 1
            next_tip += 45
        time.sleep(3)
    print()
    return False

def tail_log(path, stop_event):
    """Tail a log file in background."""
    try:
        with open(path, "r") as f:
            f.seek(0, 2)
            while not stop_event.is_set():
                line = f.readline()
                if line:
                    line = line.strip()
                    if any(k in line.lower() for k in ["error", "fail", "exception"]):
                        print(f"    {RED}{line}{RST}")
                    elif any(k in line.lower() for k in ["sync", "adb", "ota", "firmware", "connect"]):
                        print(f"    {CYAN}{line}{RST}")
                    else:
                        print(f"    {DIM}{line}{RST}")
                else:
                    time.sleep(0.5)
    except:
        pass


